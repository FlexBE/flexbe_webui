{
    "allow_editors": [
        "gnome-text-editor",
        "code",
        "gedit",
        "kate",
        "geany",
        "subl",
        "sublime_text"
    ],
    "code_indentation": 2,
    "collapse_error": false,
    "collapse_hint": false,
    "collapse_info": true,
    "collapse_warn": true,
    "commands_enabled": false,
    "commands_key": "FlexBE WebUI",
    "dashboard_text_bold": false,
    "dashboard_text_size": 86.5,
    "default_package": "flexbe_turtlesim_demo_flexbe_behaviors",
    "editor_command": "gnome-text-editor -s $FILE",
    "explicit_states": false,
    "gridsize": 50,
    "initialize_flexbe_core": true,
    "license": "BSD-3",
    "license_file": "",
    "pkg_cache_enabled": false,
    "runtime_timeout": 10,
    "save_in_source": true,
    "server_timeout": 0.25,
    "source_code_root": "${WORKSPACE_ROOT}/src",
    "statemachine_text_bold": true,
    "statemachine_text_extra_bold": false,
    "statemachine_text_size": 86.5,
    "stop_behaviors": false,
    "structured_request_logging": true,
    "synthesis_enabled": true,
    "synthesis_system": "system_wide",
    "synthesis_topic": "/flexbe_synthesis",
    "synthesis_type": "flexbe_synthesis_msgs/FlexBESynthesis",
    "target_line_length": 100,
    "text_encoding": "UTF-8",
    "transition_line_width_bold": 3.0,
    "transition_line_width_extra_bold": 4.0,
    "transition_line_width_normal": 2.0,
    "transition_mode": 1,
    "visualize_whitespace": true
}
